# dss-po (PO / 내자) — 환경변수 보기
#
# 실제 값은 .env.local 에 적는다(.gitignore 가 막는다). 이 파일에는 **비밀값을
# 적지 않는다** — 무엇이 필요한지와 어디서 얻는지만 적는다.
#
# 이 사이트의 포트는 3600 이다(A/S 3000 · 통합 로그인 3100 · 회사 홈페이지 3200 ·
# 계측기 3300 · 출석부 3400 · 개선요청 3500 이 이미 쓴다).

# ── DB ──────────────────────────────────────────────────────────────────
#
# 🔴 새 DB 를 만들지 않는다. **A/S 관리 시스템과 같은 dss_as** 를 본다
#    (개발은 컨테이너 dss-pg-app, 호스트 포트 5442). 까닭은 설계서
#    PO_DOMESTIC_SPLIT_DESIGN.md 의 B-2 · D절에 있다.
# 🔴 그래서 이 저장소에는 마이그레이션이 없다. `drizzle/` 도 `drizzle.config.ts` 도
#    `db:generate` · `db:migrate` 스크립트도 두지 않는다 — 칸을 더하거나 고치는
#    일은 언제나 A/S 에서 한다(설계서 E-2절).
#
# 값은 A/S 저장소(RF_Service_System)의 .env.local 에 있는 것과 **같게** 맞춘다.
DATABASE_URL=postgres://<사용자>:<비밀번호>@localhost:5442/dss_as

# ── DB 시험 (`npm run test:db`) ─────────────────────────────────────────
#
# 🔴 이 값은 `.env.local` 이 아니라 **`.env.test.local`** 에 적는다. 두 파일을
#    가르는 것이 안전장치의 절반이다 — 평소 개발에서는 이 값이 아예 안 읽힌다.
#
# 🔴 DB 이름은 반드시 `_test` 로 끝나야 하고, 위 DATABASE_URL 과 **같은 곳을
#    가리키면 안 된다.** 둘 중 하나라도 어긋나면 시험이 시작되지 않는다
#    (src/lib/db/test-database-safety.ts). 까닭: 위 DATABASE_URL 의 dss_as 에는
#    A/S 의 **실제 업무 자료**가 들어 있다.
#
# 시험 DB 를 만들고 표를 세우는 일은 **A/S 저장소에서** 한다(이 저장소에는
# 마이그레이션이 없다). 순서는 docs/DB_TESTS.md 를 볼 것.
#
#   .env.test.local:
#   TEST_DATABASE_URL=postgres://<사용자>:<비밀번호>@localhost:5442/dss_as_test

# ── 첨부 저장 루트 ──────────────────────────────────────────────────────
#
# 🔴 **A/S 관리 시스템과 같은 폴더**를 가리켜야 한다. 갈라지면 저쪽에서 붙인
#    첨부가 여기서 안 열린다 — 두 사이트가 같은 `attachments` 표를 보는데 그
#    표에는 루트 아래의 상대 경로(`quotes/{견적서id}/{첨부id}.pdf`)만 들어 있고,
#    루트는 이 설정값 하나뿐이기 때문이다. A/S 의 `.env.example` 에 적힌 값과
#    글자까지 같게 맞춘다(저쪽도 같은 이름 · 같은 값이다).
#    🔴 **시험으로 막을 수 없는 자리다** — 이 저장소는 A/S 의 설정을 읽을 수 없다.
#
# 🔴 **조각 3d-2 부터 실제로 읽는다.** 엑셀 전용 견적서의 [견적서 받기]가 이 루트
# 아래의 파일을 열어 내려준다(src/lib/storage/local-fs-adapter.ts 의
# `resolveUploadsRoot`). 값이 없으면 **조용한 기본값으로 넘어가지 않고 던진다** —
# 그 장을 받으려 하면 500 이 된다(일반 견적서 받기는 이 값을 보지 않는다).
#
# 운영(NAS)에서는 컨테이너 안의 경로를 적는다 — A/S 컨테이너가 보는 것과 같은
# 볼륨이어야 한다.
UPLOADS_DIR=C:\DSS-AS-DATA\uploads

# ── 견적서 공유폴더 저장 ─────────────────────────────────────────────────────
#
# 🔴 **A/S 관리 시스템과 같은 폴더**를 가리켜야 합니다(위 UPLOADS_DIR 과 같은
#    까닭입니다). 두 사이트가 같은 견적서를 발행하는데 루트가 갈리면, 한 사이트에서
#    발행한 사본이 다른 쪽에서 안 보이고 **같은 견적서 폴더가 두 군데에 생깁니다.**
#    A/S 의 `.env.example` 에 적힌 값과 글자까지 같게 맞춥니다(저쪽도 같은 이름입니다).
#    🔴 **시험으로 막을 수 없는 자리입니다** — 이 저장소는 A/S 의 설정을 읽을 수 없습니다.
#
# 견적서 파일 · 결재 PDF 를 사내 공유폴더의 연도 폴더 › 견적서 폴더에 사본으로
# 저장할 때의 루트입니다. 비우면 공유폴더 저장 기능만 꺼집니다 — 견적서 작성 ·
# 내려받기 · [견적서 받기]는 그대로 동작하고, 결과 줄이 「공유폴더 저장이 꺼져
# 있습니다」로 알려 줍니다.
#
# 🔴 **조각 3c-3 부터 실제로 읽습니다.** [견적서 수정] 탭의 [견적서 받기]가 이 루트
# 아래에 사본을 씁니다(src/lib/storage/quote-archive.ts 의 `resolveQuoteArchiveRoot`).
# 루트는 앱이 만들지 않습니다 — 연결이 빠져 폴더가 없으면 저장이 실패로 끝납니다
# (없는 루트를 만들면 컨테이너 안 임시 디스크에 저장하고 「저장했습니다」라고
# 거짓말하게 되기 때문입니다).
#
# 운영(NAS)에서는 컨테이너에 연결(마운트)한 공유폴더의 컨테이너 안 경로를 적습니다 —
# A/S 컨테이너가 보는 것과 같은 볼륨이어야 합니다.
# 실제 경로는 .env.local 에만 넣습니다.
QUOTE_ARCHIVE_DIR=

# ⚠️ 여기에는 **「A/S 의 UNC 두 줄은 이 사이트에 없습니다」**가 적혀 있었습니다.
#    🔴 **그것은 그때의 기록입니다** — 조각 PO 3g 가 **[폴더 열기]를 가져왔고**
#    (2026-09-28 사용자 결정), 그래서 아래 두 줄이 **이제 이 사이트의 설정입니다.**
#
# ── 견적서 [폴더 열기] 도우미 (조각 PO 3g) ──────────────────────────────────
#
# 🔴 **A/S 관리 시스템과 같은 곳**을 가리켜야 합니다(위 UPLOADS_DIR ·
#    QUOTE_ARCHIVE_DIR 과 같은 까닭입니다). 두 사이트의 [폴더 열기]가 **같은
#    견적서 폴더**를 열어야 하는데 루트가 갈리면, 한쪽에서 연 폴더가 다른 쪽에서는
#    「폴더를 찾을 수 없습니다」가 됩니다. A/S 의 `.env.example` 에 적힌 값과
#    글자까지 같게 맞춥니다(저쪽도 같은 이름입니다).
#    🔴 **시험으로 막을 수 없는 자리입니다** — 이 저장소는 A/S 의 설정을 읽을 수 없습니다.
#
# 🔴 **위 QUOTE_ARCHIVE_DIR 과는 다른 값입니다.** 저쪽은 서버(컨테이너)가 보는
#    경로이고, 아래 둘은 **사람이 Windows 탐색기에서 보는 주소(UNC)** 입니다.
#    같은 폴더를 가리키지만 적는 모양이 다릅니다. 발행([견적서 받기])은 위 것을,
#    [폴더 열기] 도우미는 아래 것을 씁니다.
#
# 사람이 Windows 탐색기에서 보는 공유폴더 루트입니다 — QUOTE_ARCHIVE_DIR 과 같은 곳을
# UNC 경로(\\NAS이름\공유이름\…) 모양으로 적습니다. 견적서 화면 [폴더 열기]의 도우미 설치
# 파일(현재 사용자에게만 설치 · 관리자 권한 없음)에만 들어갑니다 — 서버 응답에는 싣지 않습니다.
# 🔴 비워 두어도 됩니다 — **[폴더 열기] 기능만 꺼지고 나머지는 그대로 돕니다.** 폴더를 찾아
# 탐색기로 여는 것까지는 그대로 되고, 빠지는 것은 [위치 복사]에 쓰는 전체 주소와 도우미
# 설치 통로 둘뿐입니다(설치 통로는 「관리자가 공유폴더 주소를 설정해야 합니다」로 답합니다).
# 값을 바꾸면 각 PC 에서 설치 명령을 새로 받아 다시 실행해야 새 루트가 적용됩니다.
# 실제 경로는 .env.local 에만 넣습니다.
QUOTE_ARCHIVE_UNC_ROOT=

# 같은 공유폴더를 가리키는 **다른 주소**입니다 — 이름(\\DSS-NAS…)과 IP(\\192.168.0.222…)처럼.
# 비워 두어도 됩니다. 도우미는 위 주소로 먼저 열어 보고, 못 열면 이 주소로 한 번 더 해 봅니다.
# 이름 풀이가 안 되는 PC 가 섞여 있으면 하나만 두었을 때 그 PC 에서는 [폴더 열기]가 통째로 먹통이 됩니다.
# 잘못 적으면 없는 셈 칩니다 — 위 주소만으로 동작합니다.
QUOTE_ARCHIVE_UNC_ROOT_ALT=

# ── A/S 관리 시스템의 주소 (조각 PO 3i) ─────────────────────────────────
#
# 내자 정리 화면의 **인수번호**와 견적서 목록의 **인수번호 칸**을 누르면 A/S 의 수리 건
# 상세(`/repair-cases/{id}`)로 갑니다. 그 화면은 이 사이트에 없으므로(여기는
# domestic-orders · quotes · repair-labor · no-access 넷뿐) **저쪽 주소**가 필요합니다.
#
# 🔴 **비워 두어도 됩니다.** 그때는 링크를 만들지 않고 인수번호가 **글자로만** 보입니다 —
#    설정이 빠진 서버에서 404 로 가는 링크가 서는 것보다 낫다는 판단입니다(화면의
#    「연결 없는 줄을 링크로 만들지 않는다」와 같은 규칙).
#
# auto 는 이 기계의 사내망 IPv4 주소와 3000 번으로 풀립니다(SSO_ISSUER 와 같은 방식 —
# src/lib/lan-address.ts). `auto:3000` 처럼 포트를 적어도 되고, `http://192.168.0.10:3000`
# 처럼 직접 적어도 됩니다. 끝의 슬래시는 떼고 씁니다.
# 🔴 `http://` · `https://` 로 시작하지 않는 값은 **없는 셈 칩니다**(글자만 보입니다) —
#    설정에 엉뚱한 값이 들어갔을 때 이상한 주소를 만들지 않습니다
#    (src/lib/domain/as-app-link.ts).
#
# 운영(NAS)에서는 사람이 브라우저에서 A/S 에 접속하는 주소를 적습니다 — 이 값은 서버가
# 부르는 곳이 아니라 **브라우저가 갈 곳**이라 컨테이너 안의 주소가 아닙니다.
AS_APP_BASE_URL=auto:3000

# ── 세션 ────────────────────────────────────────────────────────────────
#
# 32자 이상. 🔴 A/S 와 **다른 값**을 쓴다 — 한쪽이 새어도 다른 쪽이 함께
# 털리지 않게. 값을 바꾸면 이미 나가 있는 세션이 전부 무효가 된다(고장이 아니다).
#   만드는 법: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_SESSION_SECRET=
# 세션 수명(시간). 비우면 12. 포털 SSO 세션의 절대 만료 12시간을 넘기지 않는다.
SESSION_HOURS=12
# 🔴 사내망 HTTP 단계에서는 반드시 비워 둔다(= false). true 로 켜면 브라우저가
#    쿠키를 저장하지 않아 로그인이 **조용히** 실패한다. HTTPS 를 붙인 뒤에 켠다.
SESSION_COOKIE_SECURE=false

# ── DSS 통합 로그인 (dss-auth 포털, 3100) ───────────────────────────────
#
# auto 는 이 기계의 사내망 IPv4 주소로 실행 시점에 풀린다(src/lib/lan-address.ts).
# Wi-Fi 주소가 바뀌어도 고칠 곳이 없다.
SSO_ISSUER=auto:3100
SSO_REDIRECT_URI=auto:3600
# 🔴 포털에 이 시스템을 등록하면서 받는다 — 조각 0c 의 몫이다.
#    개발: 포털 저장소에서 npm run client:register
SSO_CLIENT_ID=dss-po
SSO_CLIENT_SECRET=
# 로그인 왕복(state·nonce·PKCE)을 나르는 쿠키의 서명 키. 32자 이상.
# 이 서명이 곧 PKCE 다 — 없으면 브라우저가 code_verifier 를 바꿔 끼울 수 있다.
SSO_TX_SECRET=

# ── 견적서 원본 양식 (다섯) ─────────────────────────────────────────────
#
# 원본 xlsx 에 법인 직인 이미지 · 계좌번호 · 사업자 정보가 들어 있어 저장소에
# 커밋하지 않습니다. 각자 이 경로에 양식을 두고 .env.local 을 실제 경로로
# 채우세요. 프로그램은 이 파일을 **읽기만 하고 절대 쓰지 않습니다**
# (src/lib/storage/quote-template.ts 의 「읽기 전용이다」).
# OneDrive 안을 직접 가리키지 마세요 — 동기화 중 파일 잠김이 납니다.
#
# 🔴 값은 다섯 다 비워 둡니다 — 이 파일은 저장소에 올라가므로 실제 경로는
#    .env.local 에만 적습니다. 파일 이름은 자유이고, 디스크에 있는 이름과
#    맞기만 하면 됩니다.
#
# 양식은 **장비 종류 × 견적서 종류로 넷**이고 기본 문구가 넷 다 다릅니다
# (2026-08-31 실측). 특히 납기가 전부 갈립니다:
#   제너레이터 내자  발주일로부터 3주 이내
#   제너레이터 OH    발주일로부터 4주 이내
#   매쳐 내자        발행일로 부터 약 3개월 이내
#   매쳐 OH          발행일로 부터 6주
#
# 매쳐 양식은 셀 자리도 다릅니다(유효기간 D17 · 납기 D18 · 결재조건 D19 ·
# 계좌 D20, 시트 이름은 둘 다 `견적서`). 제너레이터는 D15~D18 ·
# `내자견적서`/`OH견적서` 입니다.
#
# 접두사가 없는 둘은 **제너레이터**입니다 — A/S 에서 이미 쓰이던 이름이라
# 그대로 둡니다(두 사이트가 같은 양식 파일을 가리켜도 됩니다. 읽기만 합니다).
QUOTE_TEMPLATE_PATH=
OH_QUOTE_TEMPLATE_PATH=
MATCHER_QUOTE_TEMPLATE_PATH=
MATCHER_OH_QUOTE_TEMPLATE_PATH=

# 🔴 다섯째는 위 넷과 달리 **장비 종류와 무관한 별도 견적서**입니다(수리품과
# 이어지지 않습니다). 작업 범위 구역이 없고 품목 표 하나뿐이며, 규격 칸과
# 특이사항이 있습니다. 셀 자리도 회사 정보까지 달라서 따로 읽습니다
# (src/lib/storage/quote-template.ts 의 CABLE_HEADER_CELLS).
# 다른 양식들과 같은 폴더에 두면 됩니다.
CABLE_QUOTE_TEMPLATE_PATH=

# 🔴 **검사 보고서 · 수리 보고서 양식 두 키는 여기 없습니다** — A/S 것입니다.
#    이 사이트에는 보고서 기능이 아예 없어 그 경로를 읽는 코드도 없습니다.
#    시험이 넣어 주는 양식 경로도 위 다섯뿐입니다
#    (scripts/load-template-env.ts 의 허용 목록).
