{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      // 서브모듈로 들어온 사내 공용 화면 조각(vendor/dss-ui, 별도 저장소).
      // 저장소 안의 소스라 Next 가 제 앱 코드처럼 컴파일한다 —
      // transpilePackages 도 Tailwind @source 도 필요 없다(그쪽 README 5절).
      "@dss/ui": ["./vendor/dss-ui/src/index.ts"],
      "@dss/ui/styles.css": ["./vendor/dss-ui/src/service-menu/service-menu.css"],
      // 🔴 조각마다 CSS 한 장이다 — 메뉴바(위 styles.css)와 알림 종은 **다른
      // 파일**이고, 한 장으로 묶으려면 CSS 안에서 @import 를 해야 하는데
      // 그것은 그쪽 시험이 막는다(@dss/ui README 7절). 쓰는 것만 부른다.
      //
      // 🔴 이 줄이 빠지면 tsc 는 그대로 통과하는데 화면에서 종의 생김새만
      // 통째로 빠진다(오류도 나지 않는다). 그래서 별칭이 실제 파일로 풀리는지
      // notification-bell-wiring.test.ts 가 파일 존재까지 확인한다.
      "@dss/ui/notification-bell.css": [
        "./vendor/dss-ui/src/notification-bell/notification-bell.css"
      ],
      // 서브모듈로 들어온 사내 공용 DB 스키마(vendor/dss-core, 별도 저장소).
      // A/S 관리 시스템과 이 사이트가 같은 dss_as 를 **같은 타입**으로 본다 —
      // 손으로 베낀 복제본이 아니라 한 벌이라 컴파일러가 어긋남을 잡아 준다.
      //
      // 🔴 마이그레이션은 여기에 없다. `drizzle/` 과 `drizzle.config.ts` 는
      //    A/S 가 소유하고, 칸을 더하거나 고치는 일은 언제나 A/S 에서 한다
      //    (설계서 PO_DOMESTIC_SPLIT_DESIGN.md E-2절).
      "@dss/core/schema": ["./vendor/dss-core/src/schema/index.ts"],
      // 🔴 두 사이트가 **한 벌로 그리는** 화면 조각(같은 서브모듈). 견적서 목록은
      //    이 사이트와 A/S 수리 건 상세 [견적서] 탭이 함께 그리는 화면이라,
      //    복사본을 두면 「금액·요약 줄이 갈라지는 날」이 온다
      //    (설계서 PO_DOMESTIC_SPLIT_DESIGN.md F절 5번).
      //
      // 배럴 한 줄(`@dss/core/ui`)로 묶지 않고 **깊은 경로**로 하나씩 들여온다 —
      // 그쪽에는 `"use client"` 파일과 순수 함수가 섞여 있어, 배럴을 두면 순수 함수
      // 하나를 부르려다 화면 조각 전부가 딸려 온다(시험 러너에서는 `next/navigation`
      // 을 읽다 터진다). 그쪽 README 3절에 같은 말이 적혀 있다.
      "@dss/core/ui/*": ["./vendor/dss-core/src/ui/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
